# Copy to .env and fill in from Supabase: Project Settings -> API (Data API / API Keys).
# Both values end up in the public page, so use the anon / publishable key, never the service_role / secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Browser notifications for editors (see supabase/migrations/20261022000000_push_notifications.sql).
# VAPID_PUBLIC goes into the page; the other two are secrets: copy them to the Cloudflare Pages project
# (wrangler pages secret put, together with SUPABASE_URL and SUPABASE_KEY) and NOTIFY_SECRET to Supabase's Vault.
VAPID_PUBLIC=
VAPID_PRIVATE_JWK=
NOTIFY_SECRET=
